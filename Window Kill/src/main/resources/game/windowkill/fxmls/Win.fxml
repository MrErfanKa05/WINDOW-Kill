        </Label>
        <Button fx:id="menu" layoutX="303.0" layoutY="435.0" mnemonicParsing="false" prefHeight="56.0" prefWidth="94.0" style="-fx-background-color: #f11231; -fx-background-radius: 15;" text="Menu">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
        <Label alignment="CENTER" layoutX="239.0" layoutY="84.0" prefHeight="56.0" prefWidth="222.0" text="Game Over" textFill="RED">
