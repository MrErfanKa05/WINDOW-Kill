<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.windowkill.controller.fxmlController.WinController">
    <children>
        <ImageView fitHeight="700.0" fitWidth="700.0">
            <image>
                <Image url="@../resources/gameOver.jpg" />
            </image>
        </ImageView>
        <Label alignment="CENTER" layoutX="269.0" layoutY="241.0" prefHeight="56.0" prefWidth="162.0" text="Label" textFill="#00eeff" fx:id="xp">
            <font>
                <Font name="System Bold" size="21.0" />
            </font>
        </Label>
        <Label fx:id="time" alignment="CENTER" layoutX="269.0" layoutY="322.0" prefHeight="56.0" prefWidth="162.0" text="Label" textFill="#00ff37">
            <font>
                <Font name="System Bold" size="21.0" />
