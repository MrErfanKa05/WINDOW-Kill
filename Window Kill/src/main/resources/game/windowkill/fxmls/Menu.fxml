<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.windowkill.controller.fxmlController.MenuController">
   <children>
      <ImageView fitHeight="700.0" fitWidth="700.0">
         <image>
            <Image url="@../resources/background2.jpg" />
         </image>
      </ImageView>
      <Button fx:id="exit" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="64.0" style="-fx-background-color: #f12112; -fx-background-radius: 15;" text="Exit">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
      <Button fx:id="start" layoutX="46.0" layoutY="299.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="98.0" style="-fx-background-color: #f11431; -fx-background-radius: 15;" text="Start">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="setting" layoutX="46.0" layoutY="378.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="98.0" style="-fx-background-color: #f11431; -fx-background-radius: 15;" text="Setting">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="tutorial" layoutX="46.0" layoutY="454.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="98.0" style="-fx-background-color: #f11431; -fx-background-radius: 15;" text="Tutorial">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button fx:id="skillTree" layoutX="46.0" layoutY="530.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="98.0" style="-fx-background-color: #f11431; -fx-background-radius: 15;" text="Skill Tree">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
